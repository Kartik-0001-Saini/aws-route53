# Copy to `backend/.env` and fill in. `.env` is gitignored — never commit it.

# ---- App ----------------------------------------------------------------
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ---- Database -----------------------------------------------------------
# Relative paths resolve against backend/. In production this must point at a
# mounted persistent volume, or the DB is wiped on every deploy and restart.
DATABASE_URL=sqlite:///./data/route53.db

# ---- CORS ---------------------------------------------------------------
# Comma-separated exact origins. No trailing slash, no wildcard — credentials
# are sent, and browsers reject `*` when they are.
CORS_ORIGINS=http://localhost:3000

# ---- Firebase (server-side verification) --------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. That downloads a JSON file. Base64 the whole file and paste the
# single-line result here:
#
#   PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
#
# Leave EMPTY to run without Google sign-in — the demo login still works, so
# the whole app is usable before Firebase is configured.
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=

# ---- Demo user ----------------------------------------------------------
# Signs the demo session token. Any long random string; must differ in prod.
#   PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
DEMO_TOKEN_SECRET=change-me-in-production
DEMO_USER_EMAIL=demo@route53-clone.dev
DEMO_USER_NAME=Demo User
